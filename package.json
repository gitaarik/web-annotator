{
	"name": "web-annotator",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"browser-service"
	],
	"scripts": {
		"seed": "node scripts/seed-samples.mjs",
		"predev": "node scripts/seed-samples.mjs",
		"dev": "vite dev",
		"dev:browser": "npm start --workspace=browser-service",
		"dev:all": "npm run dev:browser & sleep 2 && npm run dev",
		"clear-profile": "./clear-chrome-profile.sh",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"docker:build": "docker compose build",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"docker:restart": "docker compose down && docker compose build && docker compose up -d",
		"docker:logs": "docker compose logs -f",
		"docker:browser": "docker compose up browser-service"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25.9.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.7"
	}
}
